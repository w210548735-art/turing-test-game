SITE_ADDRESS=https://alpha.example.com
WEB_ORIGIN=https://alpha.example.com
ALLOWED_ORIGINS=https://alpha.example.com
PUBLIC_WEB_URL=https://alpha.example.com
# Caddy 与服务端位于 Docker 私有网段；禁止设置为 true。
TRUST_PROXY=loopback, linklocal, uniquelocal
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=turing
POSTGRES_DB=turing
POSTGRES_PASSWORD=replace-with-a-long-random-password

BAN_IDENTIFIER_PEPPER=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
ADMIN_PRINCIPALS_JSON=[]
DEEPSEEK_API_KEY_SECRET_FILE=./secrets/deepseek_api_key.txt
QQ_SMTP_USER=sender@example.com
QQ_SMTP_FROM_NAME=图灵测试
QQ_SMTP_AUTH_CODE_SECRET_FILE=./secrets/qq_smtp_auth_code.txt
FEEDBACK_RECIPIENT_EMAIL=admin@example.com
SECRET_GID=999
REGISTRATION_OPEN=true
ALLOW_ONLINE_GUESTS=false

AI_MAX_CONCURRENCY=20
AI_HOURLY_REQUEST_LIMIT=1000
AI_DAILY_TOKEN_BUDGET=1000000
MATCH_MAX_CONCURRENT_ROOMS=50
MATCH_MAX_QUEUE_SIZE=500
