# DeepSeek 密钥只允许配置在服务端环境变量中。
DEEPSEEK_API_KEY=

# 也可以指向本地密钥文件；不要把密钥文件提交到版本控制。
DEEPSEEK_API_KEY_FILE=

DEEPSEEK_MODEL=deepseek-v4-flash
PORT=8787
WEB_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
# 生产环境必填，至少 32 字节随机值；用于会话绑定 CSRF 摘要。
CSRF_SECRET=

# QQ 邮箱仅用于 SMTP 发信，不需要 IMAP。授权码优先放入只读 Secret 文件。
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE_FILE=
QQ_SMTP_FROM_NAME=图灵测试
# 仅供无法挂载 Secret 文件的运行平台使用，禁止提交真实值。
QQ_SMTP_AUTH_CODE=
REGISTRATION_OPEN=true
# 生产和账户联调默认关闭线上游客；仅兼容旧 Demo 回测时显式设为 true。
ALLOW_ONLINE_GUESTS=false

# 封闭 Alpha 部署必填；本地 Demo 留空时使用显式内存降级。
DATABASE_URL=
REDIS_URL=
BAN_IDENTIFIER_PEPPER=
ADMIN_PRINCIPALS_JSON=[]

AI_MAX_CONCURRENCY=20
AI_HOURLY_REQUEST_LIMIT=1000
AI_DAILY_TOKEN_BUDGET=1000000
